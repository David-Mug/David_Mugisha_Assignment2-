rules_version = '2';

// CampusCare Storage Security Rules.
// Size limit must match AppConstants.maxPhotoBytes (5 MB).
service firebase.storage {
  match /b/{bucket}/o {

    function isVerifiedAlu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com');
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // incident_photos/{uid}/{incidentId}.jpg — written once by the reporter.
    match /incident_photos/{uid}/{fileName} {
      allow read: if isVerifiedAlu();
      allow create: if isVerifiedAlu() && request.auth.uid == uid && isValidImage();
      // Delete is only used to clean up when saving the report failed.
      allow delete: if isVerifiedAlu() && request.auth.uid == uid;
      allow update: if false;
    }

    // profile_photos/{uid}/avatar.jpg — owner can replace their own avatar.
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && isValidImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
